<Window x:Class="MultipleRobloxInstances.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multiple Roblox Instances"
        Height="160" Width="522"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}">

    <Grid Background="White">
        <!-- Dark card matching MainWindow's #0C0C0C background -->
        <Grid x:Name="Card" Width="522" Height="160" Background="#FF0C0C0C">

            <!-- Purple accent line at very top -->
            <Rectangle VerticalAlignment="Top" Height="2" Fill="#FF9B62F9" Opacity="0.6"/>

            <!-- Main content -->
            <StackPanel VerticalAlignment="Center" Margin="28,0,28,12">

                <!-- App title -->
                <Label x:Name="SplashTitle"
                       Content="Multiple Roblox Instances"
                       FontFamily="Calibri Light"
                       FontSize="22"
                       Foreground="White"
                       Padding="0"
                       Margin="0,0,0,6"/>

                <!-- Status line -->
                <TextBlock x:Name="SplashStatus"
                           Text="Starting up..."
                           FontFamily="Calibri Light"
                           FontSize="11"
                           Foreground="#FF737373"
                           Margin="2,0,0,14"/>

                <!-- Progress track -->
                <Grid Height="2" Background="#19FFFFFF">
                    <Rectangle x:Name="ProgressFill"
                               HorizontalAlignment="Left"
                               Width="0"
                               Fill="#FF9B62F9">
                        <Rectangle.Effect>
                            <BlurEffect Radius="2"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- Glow copy (no blur, sharp) -->
                    <Rectangle x:Name="ProgressFillSharp"
                               HorizontalAlignment="Left"
                               Width="0"
                               Fill="#FF9B62F9"/>
                </Grid>
            </StackPanel>

            <!-- Subtle launcher detection badge at bottom-right -->
            <TextBlock x:Name="LauncherHint"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,10,6"
                       FontFamily="Calibri Light"
                       FontSize="9"
                       Foreground="#FF3A3A3A"
                       Text="Detecting launcher..."/>

        </Grid>
    </Grid>
</Window>
